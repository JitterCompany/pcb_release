# PCB release config. Full option reference: pcb_release/README.md
#
# Anything KiCad already knows -- stackup, size, via tenting, SMD/THT placement -- is
# extracted from the board. This file is only what KiCad cannot know: what you are
# asking the fab for. Defaults are sane, so set the four below and you are done.

[board]
# name = "my-board-2"     # deliverable name + the text checked on the silkscreen.
                          # Default: the KiCad project name.
# date = "auto"           # let a release build stamp today into the title blocks.

[fab]
surface_finish    = "ENIG"                 # or "HASL-LF", "any"
soldermask_color  = "green"                # or "any"
silkscreen_color  = "white"                # or "any"
via_treatment     = "tented both sides"    # or "any" -- cross-checked against KiCad

[stackup]
spec = "standard"         # standard | impedance | controlled
